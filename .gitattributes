* text=auto

# Keep Windows-facing project sources consistent on checkout.
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.cpp text eol=crlf
*.hpp text eol=crlf
*.h text eol=crlf
*.qrc text eol=crlf
*.ui text eol=crlf
*.bat text eol=crlf

# Repository metadata and CMake files use LF.
*.md text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
